{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bringalong",
  "account_id": "e7eac0650da639f1956d1d99d2c25329",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bringalong-db",
      "database_id": "47943fc0-edc6-4469-9806-ab3e247b5878",
      "migrations_dir": "drizzle"
    }
  ]
}
